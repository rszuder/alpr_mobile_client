<resources>
    <color name="tv_ref_background">#17160D</color>
    <color name="tv_ref_surface">#2C2B19</color>
    <color name="tv_ref_border">#67624B</color>
    <color name="tv_ref_accent">#32D2E4</color>
    <color name="tv_ref_text">#F5F2E6</color>
    <color name="tv_ref_secondary">#D0CCBA</color>
    <string name="tv_ref_camera">Ustaw kadr</string>
    <string name="tv_ref_corners">Narożniki TV</string>
    <string name="tv_ref_precise">Precyzyjny wybór rogu</string>
    <string name="tv_ref_instruction_title">Ustaw narożniki telewizora</string>
    <style name="TvRefCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tv_ref_surface</item>
        <item name="cardCornerRadius">16dp</item><item name="strokeColor">@color/tv_ref_border</item>
        <item name="strokeWidth">1dp</item><item name="cardElevation">0dp</item>
    </style>
    <style name="TvRefTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/tv_ref_text</item><item name="iconTint">@color/tv_ref_accent</item>
        <item name="android:textSize">14sp</item><item name="android:minHeight">48dp</item>
        <item name="android:gravity">start|center_vertical</item><item name="android:textAllCaps">false</item>
    </style>
</resources>
