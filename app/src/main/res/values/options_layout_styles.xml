<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="options_background">#0B1118</color>
    <color name="options_surface">#151D27</color>
    <color name="options_outline">#2A3542</color>
    <color name="options_accent">#38BDF8</color>
    <color name="options_text">#F1F5F9</color>
    <color name="options_muted">#9AA8B9</color>
    <style name="Theme.ALPR_v1.Options" parent="Theme.ALPR_v1">
        <item name="android:windowBackground">@color/options_background</item>
        <item name="android:textColorPrimary">@color/options_text</item>
        <item name="android:textColorSecondary">@color/options_muted</item>
        <item name="android:textColorHint">@color/options_muted</item>
        <item name="colorPrimary">@color/options_accent</item>
        <item name="colorOnPrimary">@color/options_background</item>
        <item name="colorSecondary">@color/options_accent</item>
        <item name="colorOnSecondary">@color/options_background</item>
        <item name="colorSurface">@color/options_surface</item>
        <item name="colorSurfaceVariant">@color/options_surface</item>
        <item name="colorSurfaceContainer">@color/options_surface</item>
        <item name="colorSurfaceContainerHigh">@color/options_surface</item>
        <item name="colorSurfaceContainerHighest">@color/options_surface</item>
        <item name="colorOnSurface">@color/options_text</item>
        <item name="colorOnSurfaceVariant">@color/options_muted</item>
        <item name="colorOutline">@color/options_outline</item>
        <item name="colorControlActivated">@color/options_accent</item>
        <item name="materialButtonStyle">@style/Options.Action</item>
    </style>
    <style name="Options.Body" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/options_text</item>
    </style>
    <style name="Options.Caption" parent="Options.Body">
        <item name="android:textSize">13sp</item><item name="android:textColor">@color/options_muted</item>
    </style>
    <style name="Options.GroupTitle" parent="Options.Body">
        <item name="android:textStyle">bold</item><item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">20dp</item><item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Options.Header" parent="Widget.Material3.Button.TextButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="Options.Help" parent="Widget.Material3.Button.TextButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="Options.Action" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item><item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/options_choice_text</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">16dp</item><item name="android:paddingVertical">10dp</item>
        <item name="backgroundTint">@color/options_choice_background</item>
        <item name="strokeColor">@color/options_choice_stroke</item><item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Options.Choice" parent="Options.Action">
        <item name="android:minHeight">48dp</item><item name="android:textSize">13sp</item>
        <item name="android:paddingHorizontal">4dp</item><item name="android:paddingVertical">10dp</item>
    </style>
    <style name="Options.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item><item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item><item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/options_choice_stroke</item><item name="hintTextColor">@color/options_muted</item>
    </style>
    <style name="Options.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">8dp</item><item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item><item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/options_choice_stroke</item><item name="hintTextColor">@color/options_muted</item>
    </style>
</resources>
