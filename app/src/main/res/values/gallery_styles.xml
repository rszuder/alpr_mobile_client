<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GalleryTimingHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/alpr_text_secondary</item>
    </style>
    <style name="GalleryTimingValue" parent="GalleryTimingHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alpr_text_primary</item>
    </style>
    <style name="GalleryActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">76dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">5dp</item>
        <item name="iconSize">22dp</item>
    </style>
</resources>
