<resources>
    <style name="ThemeOverlay.Alpr.CameraPopup" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/alpr_surface</item>
        <item name="colorSurfaceContainer">@color/alpr_surface</item>
        <item name="colorSurfaceContainerHigh">@color/alpr_surface</item>
        <item name="colorOnSurface">@color/alpr_text_primary</item>
        <item name="android:colorBackground">@color/alpr_surface</item>
        <item name="android:popupBackground">@color/alpr_surface</item>
        <item name="android:textColorPrimary">@color/alpr_text_primary</item>
        <item name="android:textColorSecondary">@color/alpr_text_secondary</item>
        <item name="colorControlNormal">@color/alpr_accent</item>
    </style>
    <style name="ThemeOverlay.Alpr.TvSetupDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/alpr_surface</item>
        <item name="colorSurfaceContainerHigh">@color/alpr_surface</item>
        <item name="colorOnSurface">@color/alpr_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/alpr_text_secondary</item>
        <item name="android:textColorPrimary">@color/alpr_text_primary</item>
        <item name="android:textColorSecondary">@color/alpr_text_secondary</item>
    </style>
    <style name="TvCornerButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item><item name="android:minWidth">48dp</item>
        <item name="android:textSize">16sp</item><item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/alpr_accent</item><item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="TvSetupInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">8dp</item><item name="android:textColorHint">@color/alpr_text_secondary</item>
        <item name="hintTextColor">@color/alpr_accent</item><item name="boxStrokeColor">@color/alpr_accent</item>
    </style>
    <style name="TvSetupEditText">
        <item name="android:textColor">@color/alpr_text_primary</item><item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item><item name="android:inputType">numberDecimal</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
