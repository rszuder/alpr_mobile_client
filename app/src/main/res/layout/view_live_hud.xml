<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@+id/hud1_module" android:layout_width="180dp" android:layout_height="80dp" android:orientation="vertical" android:background="@drawable/bg_instrument_module">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cockpit_fps_block" style="@style/InstrumentCell">
                <TextView  style="@style/InstrumentCaption" android:text="FPS" />
                <TextView android:id="@+id/hud_camera_fps" style="@style/InstrumentValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cockpit_temperature_block" style="@style/InstrumentCell">
                <TextView  style="@style/InstrumentCaption" android:text="TMP °C" />
                <TextView android:id="@+id/hud_temperature" style="@style/InstrumentValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cockpit_resources_block" style="@style/InstrumentCell">
                <TextView  style="@style/InstrumentCaption" android:text="RES %" />
                <TextView android:id="@+id/hud_resources" style="@style/InstrumentValue" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cockpit_mp_block" style="@style/InstrumentCell">
                <TextView android:id="@+id/hud_mp_caption" style="@style/InstrumentCaption" android:text="MP ms" />
                <TextView android:id="@+id/hud_mp_time" style="@style/InstrumentValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cockpit_mt_block" style="@style/InstrumentCell">
                <TextView android:id="@+id/hud_mt_caption" style="@style/InstrumentCaption" android:text="MT ms" />
                <TextView android:id="@+id/hud_mt_time" style="@style/InstrumentValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cockpit_mz_block" style="@style/InstrumentCell">
                <TextView android:id="@+id/hud_mz_caption" style="@style/InstrumentCaption" android:text="MZ ms" />
                <TextView android:id="@+id/hud_mz_time" style="@style/InstrumentValue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/live_hud" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:importantForAccessibility="no" />
</merge>
