<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end">
        <LinearLayout style="@style/HudPill">
            <TextView style="@style/HudPillCaption" android:text="FPS" android:drawableStart="@drawable/ic_hud_fps" />
            <TextView android:id="@+id/hud_camera_fps" style="@style/HudPillValue" android:textColor="@color/alpr_success" />
        </LinearLayout>
        <LinearLayout style="@style/HudPill" android:layout_marginStart="4dp">
            <TextView style="@style/HudPillCaption" android:text="TMP" android:drawableStart="@drawable/ic_hud_temperature" />
            <TextView android:id="@+id/hud_temperature" style="@style/HudPillValue" />
        </LinearLayout>
        <LinearLayout style="@style/HudPill" android:layout_marginStart="4dp">
            <TextView style="@style/HudPillCaption" android:text="RES" android:drawableStart="@drawable/ic_hud_cpu" />
            <TextView android:id="@+id/hud_resources" style="@style/HudPillValue" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/HudStage" android:layout_marginTop="8dp">
        <TextView style="@style/HudStageCaption" android:text="MP" android:textColor="@color/alpr_accent" />
        <TextView android:id="@+id/hud_mp_time" style="@style/HudStageValue" />
    </LinearLayout>
    <ImageView style="@style/HudArrow" />
    <LinearLayout style="@style/HudStage">
        <TextView style="@style/HudStageCaption" android:text="MT" android:textColor="@color/alpr_secondary" />
        <TextView android:id="@+id/hud_mt_time" style="@style/HudStageValue" />
    </LinearLayout>
    <ImageView style="@style/HudArrow" />
    <LinearLayout style="@style/HudStage">
        <TextView style="@style/HudStageCaption" android:text="MZ" android:textColor="@color/alpr_success" />
        <TextView android:id="@+id/hud_mz_time" style="@style/HudStageValue" />
    </LinearLayout>
    <!-- Retained for the presentation controller; detailed diagnostics do not cover the camera. -->
    <TextView android:id="@+id/live_hud" android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:importantForAccessibility="no" />
</merge>
