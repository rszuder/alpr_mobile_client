<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_export_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="14dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_hud_metric">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/session_export_date" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="12sp" android:textColor="@color/alpr_text_secondary" />
            <TextView android:id="@+id/session_export_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxWidth="108dp" android:gravity="end"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/alpr_accent" />
        </LinearLayout>
        <TextView android:id="@+id/session_export_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/alpr_text_primary" />
        <TextView android:id="@+id/session_export_configuration" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/alpr_text_primary" />
        <TextView android:id="@+id/session_export_execution" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:textSize="11sp" android:lineSpacingExtra="3dp" android:textColor="@color/alpr_text_secondary" />
        <TextView android:id="@+id/session_export_series" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="10sp" android:textColor="@color/alpr_text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/session_export_status" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/session_export_action" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/alpr_accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
