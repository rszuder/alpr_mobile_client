<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_content_description"
        app:implementationMode="performance"
        app:layout_constraintBottom_toTopOf="@id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <com.example.alpr_v1.ui.DetectionOverlayView
        android:id="@+id/detection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/main_menu"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/live_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/status_pill_background"
        android:padding="10dp"
        android:text="@string/status_starting"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        android:fillViewport="false"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_height="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recognition_result_label"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_pill_background"
                    android:gravity="center"
                    android:minWidth="36dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:text="@string/result_count_zero"
                    android:textColor="@color/alpr_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery_visibility_toggle"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/gallery_show_description"
                    android:gravity="center"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minWidth="48dp"
                    android:padding="0dp"
                    android:tooltipText="@string/gallery_show_description"
                    app:icon="@drawable/ic_expand_less_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/alpr_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/recognition_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/recognition_searching"
                android:textColor="@color/alpr_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/alpr_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/collection_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/collection_ready"
                        android:textColor="@color/alpr_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/collection_toggle"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:text="@string/collection_start"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_camera_24"
                            app:iconPadding="6dp"
                            app:iconSize="22dp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/crop_select_all"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/crop_select_all"
                            android:textColor="@color/alpr_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/crop_save_selected"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:minWidth="0dp"
                            android:text="@string/crop_save_action"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_save_24"
                            app:iconPadding="5dp"
                            app:iconSize="22dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/gallery_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/results_empty"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="@string/collection_empty"
                    android:textColor="@color/alpr_text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/gallery_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="344dp"
                    android:layout_marginTop="6dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingHorizontal="2dp"
                        android:paddingBottom="60dp"
                        android:scrollbars="vertical"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gallery_size_toggle"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:contentDescription="@string/gallery_maximize_description"
                        android:gravity="center"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="52dp"
                        android:padding="0dp"
                        android:tooltipText="@string/gallery_maximize_description"
                        app:icon="@drawable/ic_gallery_maximize_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="28dp"
                        app:iconTint="@color/alpr_text_primary" />

                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
