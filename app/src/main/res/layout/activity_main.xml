<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="Overdraw"
    tools:context=".MainActivity">


    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_content_description"
        app:implementationMode="performance"
        app:layout_constraintBottom_toTopOf="@id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />


    <com.example.alpr_v1.ui.DetectionOverlayView
        android:id="@+id/detection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview" />


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/alpr_panel"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/main_menu"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:id="@+id/live_status_strip"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/live_status_strip_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar">

        <View
            android:id="@+id/live_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_live_status_dot" />

        <TextView
            android:id="@+id/live_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/status_starting"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_status_secondary"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="10sp"
            tools:text="R2 · LOCK · 10 FPS" />

        <ImageButton
            android:id="@+id/live_diagnostics_toggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/diagnostics_title"
            android:padding="5dp"
            android:src="@drawable/ic_info_24"
            app:tint="@color/alpr_text_secondary" />

    </LinearLayout>

    <TextView
        android:id="@+id/live_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/status_pill_background"
        android:elevation="7dp"
        android:maxWidth="300dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_status_strip"
        tools:text="Cel ustabilizowany" />

    <LinearLayout
        android:id="@+id/live_hud_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:elevation="7dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_event">

        <TextView
            android:id="@+id/live_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_hud_background"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxWidth="230dp"
            android:padding="9dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            tools:text="MP 0,38 s · MT 1,20 s&#10;MZ 0,31 s · PIPE 1,96 s&#10;YUV 10 FPS · 8/8 inlier" />
    </LinearLayout>

    <ImageView
        android:id="@+id/auto_zoom_target"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_auto_zoom_glow"
        android:contentDescription="@string/auto_zoom_target"
        android:elevation="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_auto_focus_zoom_24"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:tint="@color/alpr_success" />
    <!-- Timer jest elementem eksperymentalnym i pojawia się tylko przy EXP. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/experiment_timer_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/experiment_timer_button"
        android:textSize="12sp"
        android:visibility="gone"
        app:icon="@drawable/ic_timer_24"
        app:iconPadding="5dp"
        app:iconSize="21dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/experiment_thermal_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/experiment_thermal_button"
        android:textSize="11sp"
        android:visibility="gone"
        app:icon="@drawable/ic_device_24"
        app:iconPadding="5dp"
        app:iconSize="20dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview" />

    <FrameLayout
        android:id="@+id/auto_zoom_control"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="76dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview">

        <View
            android:id="@+id/auto_zoom_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_auto_zoom_glow"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auto_zoom_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/auto_zoom_enable"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/auto_zoom_symbol_ready"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/confirmed_result_tray"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/live_result_tray_background"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/confirmed_result_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="53X3237" />

            <TextView
                android:id="@+id/confirmed_result_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/alpr_success"
                android:textSize="11sp"
                tools:text="stabilne · 92%" />
        </LinearLayout>

        <TextView
            android:id="@+id/confirmed_result_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="11sp"
            tools:text="1 trafienie · cel nadal śledzony" />
    </LinearLayout>


    <!--
        Stały, mały panel sterowania.
        Nie zawiera już galerii ani przewijanego panelu.
    -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:id="@+id/recognition_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="2"
            android:text="@string/recognition_searching"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="12sp" />


        <!--
            Jeden przycisk:
            STOPPED -> Uruchom analizę
            RUNNING -> Zatrzymaj analizę
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/analysis_start_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/analysis_start"
            android:textSize="14sp"
            app:icon="@drawable/ic_camera_24"
            app:iconPadding="8dp"
            app:iconSize="22dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/collection_toggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minWidth="0dp"
                android:text="@string/collection_start"
                android:textSize="11sp"
                app:icon="@drawable/ic_session_24"
                app:iconPadding="5dp"
                app:iconSize="20dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/gallery_open_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/gallery_open_zero"
                android:textSize="11sp"
                app:icon="@drawable/ic_gallery_24"
                app:iconPadding="5dp"
                app:iconSize="20dp" />

        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_report_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:text="@string/export_short"
            android:textSize="11sp"
            app:icon="@drawable/ic_export_24"
            app:iconPadding="5dp"
            app:iconSize="20dp" />


        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
