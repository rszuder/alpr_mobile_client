<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">


    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_content_description"
        app:implementationMode="performance"
        app:layout_constraintBottom_toTopOf="@id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />


    <com.example.alpr_v1.ui.DetectionOverlayView
        android:id="@+id/detection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview" />


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/alpr_panel"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/main_menu"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <!--
        Lekki HUD telemetryczny.

        Pokazuje wyłącznie dane potrzebne podczas pracy
        z kamerą i eksperymentów. Pełna diagnostyka
        pozostaje w DiagnosticsActivity.
    -->
    <TextView
        android:id="@+id/live_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/live_hud_background"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxWidth="350dp"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar"
        tools:text="R1 · EXP · 4000×3000 · 12,0 Mpix&#10;MP 0,38 s · MT 2,97 s · MZ 0,47 s&#10;PIPE 4,63 s · DROP 16" />
    <!--
        Krótki status pracy pipeline'u.
        Nie rozciągamy go już na całą szerokość.
    -->
    <TextView
        android:id="@+id/live_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/status_pill_background"
        android:maxWidth="340dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:text="@string/status_starting"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_hud" />


    <!-- Timer jest elementem eksperymentalnym i pojawia się tylko przy EXP. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/experiment_timer_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/experiment_timer_button"
        android:textSize="12sp"
        android:visibility="gone"
        app:icon="@drawable/ic_timer_24"
        app:iconPadding="5dp"
        app:iconSize="21dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview" />


    <!--
        Stały, mały panel sterowania.
        Nie zawiera już galerii ani przewijanego panelu.
    -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:id="@+id/recognition_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/recognition_searching"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="12sp" />


        <!--
            Jeden przycisk:
            STOPPED -> Uruchom analizę
            RUNNING -> Zatrzymaj analizę
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/analysis_start_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/analysis_start"
            android:textSize="14sp"
            app:icon="@drawable/ic_camera_24"
            app:iconPadding="8dp"
            app:iconSize="22dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/collection_toggle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minWidth="0dp"
                android:text="@string/collection_start"
                android:textSize="11sp"
                app:icon="@drawable/ic_session_24"
                app:iconPadding="5dp"
                app:iconSize="20dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/gallery_open_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/gallery_open_zero"
                android:textSize="11sp"
                app:icon="@drawable/ic_gallery_24"
                app:iconPadding="5dp"
                app:iconSize="20dp" />

        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_report_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:text="@string/export_short"
            android:textSize="11sp"
            app:icon="@drawable/ic_export_24"
            app:iconPadding="5dp"
            app:iconSize="20dp" />


        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>