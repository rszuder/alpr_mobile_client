<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" tools:context=".MainActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/top_app_bar" android:layout_width="0dp" android:layout_height="48dp" android:background="@color/alpr_panel" android:elevation="4dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:menu="@menu/main_menu" app:popupTheme="@style/ThemeOverlay.Alpr.CameraPopup" app:title="@string/app_name" app:titleTextColor="@color/white" />
    <!-- This stable header is outside the camera, including while the clock changes. -->
    <FrameLayout android:id="@+id/normal_camera_hud" android:layout_width="0dp" android:layout_height="64dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:background="@color/alpr_panel" app:layout_constraintTop_toBottomOf="@id/top_app_bar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/live_status_strip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/live_status_strip_background" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:accessibilityLiveRegion="polite">
            <View android:id="@+id/live_status_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="7dp" android:background="@drawable/bg_live_status_dot" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:id="@+id/live_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="@string/status_starting" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/live_status_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="@color/alpr_text_secondary" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/experiment_timer_status" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:paddingStart="8dp" android:orientation="vertical" android:gravity="center_vertical|end" android:visibility="gone" android:importantForAccessibility="yes">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_timer_24" app:tint="@color/alpr_accent" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/experiment_timer_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/experiment_timer_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:singleLine="true" android:textColor="@color/alpr_text_secondary" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <androidx.camera.view.PreviewView android:id="@+id/camera_preview" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@string/camera_content_description" app:implementationMode="performance" app:scaleType="fitCenter" app:layout_constraintTop_toBottomOf="@id/normal_camera_hud" app:layout_constraintBottom_toTopOf="@id/tv_panel_boundary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.example.alpr_v1.ui.TvCalibrationOverlayView android:id="@+id/tv_setup_overlay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="@id/camera_preview" app:layout_constraintBottom_toBottomOf="@id/camera_preview" app:layout_constraintStart_toStartOf="@id/camera_preview" app:layout_constraintEnd_toEndOf="@id/camera_preview" />
    <com.example.alpr_v1.ui.DetectionOverlayView android:id="@+id/detection_overlay" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="@id/camera_preview" app:layout_constraintBottom_toBottomOf="@id/camera_preview" app:layout_constraintStart_toStartOf="@id/camera_preview" app:layout_constraintEnd_toEndOf="@id/camera_preview" />
    <ImageView android:id="@+id/auto_zoom_target" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_cockpit_metric" android:contentDescription="@string/auto_zoom_target" android:padding="10dp" android:src="@drawable/ic_auto_focus_zoom_24" android:visibility="gone" app:tint="@color/cockpit_cyan" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout android:id="@+id/control_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/alpr_panel" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/main_information_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_cockpit_instrument_strip">
            <LinearLayout android:id="@+id/tv_frame_summary" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cockpit_section_bottom">
                <LinearLayout android:id="@+id/main_tv_configuration" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_frame_status" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="2dp" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/alpr_accent" />
                    <TextView android:id="@+id/hud1_blocked_notice" android:layout_width="match_parent" android:layout_height="18dp" android:paddingHorizontal="4dp" android:gravity="center_vertical" android:includeFontPadding="false" android:singleLine="true" android:text="@string/cockpit_hud_no_space" android:textSize="10sp" android:textColor="@color/alpr_warning" android:visibility="invisible" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/tv_frame_edit" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="match_parent" android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="10sp" android:text="@string/tv_outline_edit" android:textColor="@color/alpr_accent" />
            </LinearLayout>
            <LinearLayout android:id="@+id/main_device_result_row" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical">
                <com.example.alpr_v1.ui.PhoneLevelView android:id="@+id/phone_orientation_panel" android:layout_width="56dp" android:layout_height="56dp" android:importantForAccessibility="yes" />
                <View android:id="@+id/instrument_level_divider" android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="4dp" android:layout_marginEnd="4dp" android:background="#667B8C9F" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/main_data_column" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
                    <FrameLayout android:id="@+id/hud2_viewport" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="false">
                        <com.example.alpr_v1.ui.LiveModelInfoView android:id="@+id/live_model_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="invisible" />
                    </FrameLayout>
                    <FrameLayout android:id="@+id/main_thermal_slot" android:layout_width="match_parent" android:layout_height="16dp" android:background="@drawable/bg_cockpit_section_bottom">
                        <TextView android:id="@+id/main_device_status" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/alpr_text_secondary" android:text="@string/main_device_na" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/experiment_thermal_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:gravity="start|center_vertical" android:textSize="10sp" android:text="@string/experiment_thermal_button" android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout android:id="@+id/main_result_slot" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <LinearLayout android:id="@+id/confirmed_result_tray" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:visibility="gone">
                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/main_result_contents" android:layout_width="match_parent" android:layout_height="match_parent">
                                <TextView android:id="@+id/confirmed_result_text" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:ellipsize="end" android:maxLines="1" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/confirmed_result_confidence" android:layout_marginEnd="4dp" app:layout_constraintTop_toTopOf="parent" />
                                <TextView android:id="@+id/confirmed_result_confidence" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/alpr_success" android:textSize="10sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
                                <TextView android:id="@+id/confirmed_result_meta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:textColor="@color/alpr_text_secondary" android:textSize="10sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                                <androidx.constraintlayout.widget.Barrier android:id="@+id/main_result_body_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="confirmed_result_text,confirmed_result_confidence" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/live_event" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:maxLines="1" android:ellipsize="end" android:background="@color/alpr_panel" android:textColor="@color/white" android:textSize="10sp" android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/recognition_hint" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/recognition_searching" android:visibility="gone" />
        <LinearLayout android:id="@+id/auto_zoom_control" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
            <FrameLayout android:id="@+id/main_slot_scene" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/live_scene_mode_toggle" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/main_grid_scene_dynamic" app:icon="@drawable/ic_scene_dynamic_24" android:contentDescription="@string/scene_mode_dynamic_action" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/search_plate_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/search_plate_start" app:icon="@drawable/ic_search_24" android:contentDescription="@string/search_vehicle" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_release" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/release_target_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/release_target_short" app:icon="@drawable/ic_release_lock_32" android:contentDescription="@string/release_vehicle" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_az" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <View android:id="@+id/auto_zoom_glow" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_auto_zoom_glow" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/auto_zoom_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/auto_zoom_symbol_ready" app:icon="@drawable/ic_adaptive_zoom_32" android:contentDescription="@string/auto_zoom_enable" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_hud1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/live_diagnostics_toggle" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/hud_1_label" app:icon="@drawable/ic_hud_32" android:contentDescription="@string/hud_1_toggle" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_hud2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/live_model_info_toggle" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/hud_2_label" app:icon="@drawable/ic_hud_cpu" android:contentDescription="@string/hud_2_toggle" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/camera_action_row" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="@dimen/main_grid_gap" android:orientation="horizontal">
            <FrameLayout android:id="@+id/main_slot_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/analysis_start_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/camera_action_start" app:icon="@drawable/ic_analysis_play_32" android:contentDescription="@string/analysis_start" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_acquisition" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/collection_toggle" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/camera_action_crops" app:icon="@drawable/ic_plate_crops_32" android:contentDescription="@string/collection_start" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_preview" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/camera_preview_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/camera_action_preview" app:icon="@drawable/ic_camera_preview_32" android:contentDescription="@string/camera_preview_start" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_gallery" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/gallery_open_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/camera_action_recent" app:icon="@drawable/ic_recent_plates_32" android:contentDescription="@string/history_open_zero" />
                <TextView android:id="@+id/gallery_count_badge" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp" android:minWidth="18dp" android:paddingHorizontal="3dp" android:gravity="center" android:background="@drawable/bg_recent_badge" android:text="0" android:textColor="@color/alpr_background" android:textSize="9sp" android:textStyle="bold" android:includeFontPadding="false" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_timer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/experiment_timer_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/experiment_timer_button" app:icon="@drawable/ic_timer_24" android:contentDescription="@string/experiment_timer_dialog_title" />
            </FrameLayout>
            <FrameLayout android:id="@+id/main_slot_export" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/main_grid_gap">
                <com.google.android.material.button.MaterialButton android:id="@+id/export_report_button" style="@style/MainGridButton" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/main_grid_export" app:icon="@drawable/ic_export_24" />
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="3dp">
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <!-- Independent nonmodal HUDs: this transparent layer never sizes the camera. -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/main_hud_storage" android:layout_width="0dp" android:layout_height="0dp" android:clickable="false" android:focusable="false" android:clipChildren="true" app:layout_constraintTop_toTopOf="@id/camera_preview" app:layout_constraintBottom_toBottomOf="@id/camera_preview" app:layout_constraintStart_toStartOf="@id/camera_preview" app:layout_constraintEnd_toEndOf="@id/camera_preview">
        <FrameLayout android:id="@+id/hud1_viewport" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:clickable="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.example.alpr_v1.ui.LiveHudView android:id="@+id/live_hud_row" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include android:id="@+id/tv_setup_panel" layout="@layout/view_tv_setup_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <include layout="@layout/view_tv_reference_shell" />
    <androidx.constraintlayout.widget.Barrier android:id="@+id/tv_panel_boundary" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="top" app:barrierAllowsGoneWidgets="false" app:constraint_referenced_ids="control_panel,tv_setup_panel" />
</androidx.constraintlayout.widget.ConstraintLayout>
