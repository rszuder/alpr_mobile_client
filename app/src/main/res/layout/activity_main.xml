<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="Overdraw"
    tools:context=".MainActivity">


    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_content_description"
        app:implementationMode="performance"
        app:layout_constraintBottom_toTopOf="@id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fitCenter" />


    <com.example.alpr_v1.ui.DetectionOverlayView
        android:id="@+id/detection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview" />


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/alpr_panel"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/main_menu"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:id="@+id/live_status_strip"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/live_status_strip_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/live_diagnostics_toggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar">

        <View
            android:id="@+id/live_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_live_status_dot" />

        <TextView
            android:id="@+id/live_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/status_starting"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_status_secondary"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/live_diagnostics_toggle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="68dp" android:layout_height="40dp"
            android:layout_marginEnd="6dp" android:layout_marginTop="10dp"
            android:elevation="6dp" android:minWidth="0dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="7dp"
            android:text="@string/hud_1_label" android:textSize="9sp" android:textStyle="bold"
            android:textColor="@color/alpr_accent" android:contentDescription="@string/hud_1_toggle"
            app:icon="@drawable/ic_hud_32" app:iconSize="19dp" app:iconPadding="4dp"
            app:iconTint="@color/alpr_accent" app:strokeColor="@color/alpr_outline"
            app:backgroundTint="@color/alpr_card_blue" app:cornerRadius="10dp"
            app:layout_constraintEnd_toStartOf="@id/live_model_info_toggle"
            app:layout_constraintTop_toBottomOf="@id/top_app_bar" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/live_model_info_toggle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="68dp" android:layout_height="40dp"
            android:layout_marginEnd="12dp" android:layout_marginTop="10dp"
            android:elevation="6dp" android:minWidth="0dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="7dp"
            android:text="@string/hud_2_label" android:textSize="9sp" android:textStyle="bold"
            android:textColor="@color/alpr_accent" android:contentDescription="@string/hud_2_toggle"
            app:icon="@drawable/ic_hud_cpu" app:iconSize="19dp" app:iconPadding="4dp"
            app:iconTint="@color/alpr_accent" app:strokeColor="@color/alpr_outline"
            app:backgroundTint="@color/alpr_card_blue" app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_app_bar" />

    <TextView
        android:id="@+id/live_event"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/status_pill_background"
        android:elevation="7dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintWidth_max="220dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toStartOf="@id/live_hud_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_diagnostics_toggle"
        tools:text="Cel ustabilizowany" />

    <com.example.alpr_v1.ui.LiveHudView
        android:id="@+id/live_hud_row"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_diagnostics_toggle" />

    <com.example.alpr_v1.ui.PhoneLevelView
        android:id="@+id/phone_orientation_panel"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="visible"
        android:importantForAccessibility="yes"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintBottom_toTopOf="@id/confirmed_result_tray" />

    <com.example.alpr_v1.ui.LiveModelInfoView
        android:id="@+id/live_model_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/auto_zoom_control" />

    <ImageView
        android:id="@+id/auto_zoom_target"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_auto_zoom_glow"
        android:contentDescription="@string/auto_zoom_target"
        android:elevation="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_auto_focus_zoom_24"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:tint="@color/alpr_success" />
    <!-- Timer jest elementem eksperymentalnym i pojawia się tylko przy EXP. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/experiment_timer_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/experiment_timer_button"
        android:textSize="12sp"
        android:visibility="gone"
        app:icon="@drawable/ic_timer_24"
        app:iconPadding="5dp"
        app:iconSize="21dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/experiment_thermal_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/experiment_thermal_button"
        android:textSize="11sp"
        android:visibility="gone"
        app:icon="@drawable/ic_device_24"
        app:iconPadding="5dp"
        app:iconSize="20dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview" />

    <FrameLayout
        android:id="@+id/auto_zoom_control"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/experiment_thermal_button"
        app:layout_goneMarginBottom="16dp"
        app:layout_constraintWidth_max="352dp"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/live_scene_mode_toggle"
                style="@style/CameraActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:contentDescription="@string/scene_mode_dynamic_action"
                android:text="@string/scene_control_dynamic"
                app:icon="@drawable/ic_scene_dynamic_24" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_plate_button"
                style="@style/CameraActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/search_vehicle"
                android:text="@string/search_plate_start"
                app:icon="@drawable/ic_search_24" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/release_target_button"
                style="@style/CameraActionButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/release_vehicle"
                android:text="@string/release_target_short"
                app:icon="@drawable/ic_release_lock_32" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp">

        <View
            android:id="@+id/auto_zoom_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_auto_zoom_glow"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auto_zoom_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/auto_zoom_enable"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="8dp"
            android:text="@string/auto_zoom_symbol_ready"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/alpr_surface"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_adaptive_zoom_32"
            app:iconGravity="textTop"
            app:iconPadding="4dp"
            app:iconSize="32dp"
            app:rippleColor="@color/alpr_accent"
            app:strokeWidth="1dp" />
        </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/confirmed_result_tray"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/live_result_tray_background"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/live_model_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/confirmed_result_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="53X3237" />

            <TextView
                android:id="@+id/confirmed_result_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/alpr_success"
                android:textSize="11sp"
                tools:text="stabilne · 92%" />
        </LinearLayout>

        <TextView
            android:id="@+id/confirmed_result_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="11sp"
            tools:text="1 trafienie · cel nadal śledzony" />
    </LinearLayout>


    <!--
        Stały, mały panel sterowania.
        Nie zawiera już galerii ani przewijanego panelu.
    -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">



        <TextView
            android:id="@+id/recognition_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="2"
            android:text="@string/recognition_searching"
            android:textColor="@color/alpr_text_secondary"
            android:textSize="12sp" />


        <LinearLayout
            android:id="@+id/camera_action_row"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/analysis_start_button" style="@style/CameraActionButton"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:text="@string/camera_action_start" android:contentDescription="@string/analysis_start"
                app:icon="@drawable/ic_analysis_play_32" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/collection_toggle" style="@style/CameraActionButton"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="8dp" android:enabled="false"
                android:text="@string/camera_action_crops" android:contentDescription="@string/collection_start"
                app:icon="@drawable/ic_plate_crops_32" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/camera_preview_button" style="@style/CameraActionButton"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="@string/camera_action_preview"
                android:contentDescription="@string/camera_preview_start" app:icon="@drawable/ic_camera_preview_32" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery_open_button" style="@style/CameraActionButton"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="@string/camera_action_recent" android:contentDescription="@string/history_open_zero"
                    app:icon="@drawable/ic_recent_plates_32" />
                <TextView android:id="@+id/gallery_count_badge"
                    android:layout_width="wrap_content" android:layout_height="20dp"
                    android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="5dp"
                    android:minWidth="20dp" android:paddingHorizontal="5dp" android:gravity="center"
                    android:background="@drawable/bg_recent_badge" android:text="0"
                    android:textColor="@color/alpr_background" android:textSize="9sp" android:textStyle="bold"
                    android:includeFontPadding="false" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_report_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:text="@string/export_short"
            android:textSize="11sp"
            app:icon="@drawable/ic_export_24"
            app:iconPadding="5dp"
            app:iconSize="20dp" />


        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
