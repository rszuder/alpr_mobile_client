<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/history_detail_scroll" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history_detail_title"
            android:textColor="@color/alpr_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_detail_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_close"
            app:icon="@drawable/ic_close_24" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <com.example.alpr_v1.ui.PlateCropView
            android:id="@+id/history_detail_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/history_detail_characters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/alpr_success"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/history_detail_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/alpr_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/history_detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/alpr_text_secondary"
        android:textSize="13sp" />

    <com.example.alpr_v1.ui.RecognitionEntityPager
        android:id="@+id/history_detail_entities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_detail_copy"
            style="@style/GalleryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/history_copy_action"
            android:textSize="11sp"
            app:icon="@drawable/ic_copy_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_detail_save"
            style="@style/GalleryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/history_save_action"
            android:textSize="11sp"
            app:icon="@drawable/ic_save_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_detail_delete"
            style="@style/GalleryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/history_delete_action"
            android:textColor="@color/alpr_error"
            android:textSize="11sp"
            app:icon="@drawable/ic_delete_24"
            app:iconTint="@color/alpr_error"
            app:strokeColor="@color/alpr_error" />
    </LinearLayout>
</LinearLayout>
