<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/alpr_card"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/alpr_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="154dp"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/diagnostic_metric_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_blue"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_diagnostics_24"
            app:tint="@color/alpr_primary" />

        <TextView
            android:id="@+id/diagnostic_metric_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/alpr_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnostic_metric_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/alpr_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnostic_metric_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/alpr_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
