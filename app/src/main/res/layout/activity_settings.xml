<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:ignore="TooManyViews"
    tools:context=".SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/alpr_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/alpr_text_primary"
        app:subtitle="@string/settings_subtitle"
        app:subtitleTextColor="@color/alpr_text_muted"
        app:title="@string/settings_title"
        app:titleTextColor="@color/alpr_text_primary" />

    <ProgressBar
        android:id="@+id/settings_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_progress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_inference"
                android:textColor="@color/alpr_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/alpr_card_blue"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_blue"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_tune_24"
                            app:tint="@color/alpr_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/menu_recognition_profile"
                                android:textColor="@color/alpr_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_profile_description"
                                android:textColor="@color/alpr_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/settings_profile_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_profile_fast"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="@string/recognition_profile_fast"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_profile_balanced"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="@string/recognition_profile_balanced"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_profile_accurate"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingHorizontal="2dp"
                            android:text="@string/recognition_profile_accurate"
                            android:textSize="12sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/alpr_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_violet"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_camera_24"
                            app:tint="@color/alpr_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/menu_resolution_profile"
                                android:textColor="@color/alpr_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_resolution_description"
                                android:textColor="@color/alpr_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/settings_resolution_input"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/settings_resolution_choose">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/settings_resolution_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textSize="13sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/settings_resolution_capabilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_resolution_detecting"
                        android:textColor="@color/alpr_text_muted"
                        android:textSize="11sp" />                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/settings_section_collection"
                android:textColor="@color/alpr_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/alpr_card_violet"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_violet"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_gallery_24"
                            app:tint="@color/alpr_secondary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/menu_crop_limit"
                                android:textColor="@color/alpr_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_crop_description"
                                android:textColor="@color/alpr_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/settings_crop_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_crop_auto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15"
                            android:maxLines="1" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="@string/settings_auto_short" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_crop_10"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9"
                            android:maxLines="1" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="@string/settings_crop_10_short" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_crop_25"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9"
                            android:maxLines="1" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="@string/settings_crop_25_short" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_crop_50"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9"
                            android:maxLines="1" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="@string/settings_crop_50_short" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_crop_100"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15"
                            android:maxLines="1" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="@string/settings_crop_100_short" android:textSize="11sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/settings_section_pipeline"
                android:textColor="@color/alpr_success"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/alpr_card_green"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_green"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_model_24"
                            app:tint="@color/alpr_success" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_models_title"
                                android:textColor="@color/alpr_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_models_description"
                                android:textColor="@color/alpr_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_node_vehicle"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="76dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:maxLines="3"
                            android:minWidth="0dp"
                            android:paddingHorizontal="3dp"
                            android:text="@string/settings_node_vehicle_missing"
                            android:textAllCaps="false"
                            android:textSize="11sp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/settings_node_vehicle_badge"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:minWidth="0dp"
                            android:text="@string/settings_node_badge_missing"
                            android:textSize="11sp"
                            android:checkable="true"
                            app:chipMinHeight="28dp"
                            app:ensureMinTouchTargetSize="false" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/settings_pipeline_arrow"
                            android:textColor="@color/alpr_success"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_node_plate"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="76dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:maxLines="3"
                            android:minWidth="0dp"
                            android:paddingHorizontal="3dp"
                            android:text="@string/settings_node_plate_missing"
                            android:textAllCaps="false"
                            android:textSize="11sp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/settings_node_plate_badge"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:minWidth="0dp"
                            android:text="@string/settings_node_badge_missing"
                            android:textSize="11sp"
                            android:checkable="true"
                            app:chipMinHeight="28dp"
                            app:ensureMinTouchTargetSize="false" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/settings_pipeline_arrow"
                            android:textColor="@color/alpr_success"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_node_character"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="76dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:maxLines="3"
                            android:minWidth="0dp"
                            android:paddingHorizontal="3dp"
                            android:text="@string/settings_node_character_missing"
                            android:textAllCaps="false"
                            android:textSize="11sp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/settings_node_character_badge"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:minWidth="0dp"
                            android:text="@string/settings_node_badge_missing"
                            android:textSize="11sp"
                            android:checkable="true"
                            app:chipMinHeight="28dp"
                            app:ensureMinTouchTargetSize="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/settings_model_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/models_missing"
                        android:textColor="@color/alpr_text_primary"
                        android:textSize="11sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_import_model"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/import_model"
                        app:icon="@drawable/ic_upload_24" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_restore_base_package"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_restore_base_package" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/alpr_card_green"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_experiment_title"
                        android:textColor="@color/alpr_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_experiment_description"
                        android:textColor="@color/alpr_text_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_experiment_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_experiment_switch" />

                    <LinearLayout
                        android:id="@+id/settings_roi_experiment_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_roi_budget_title"
                            android:textColor="@color/alpr_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_roi_budget_description"
                            android:textColor="@color/alpr_text_muted"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/settings_roi_budget_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settings_roi_r0"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:paddingHorizontal="2dp"
                                android:text="@string/roi_budget_r0_short"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settings_roi_r1"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:paddingHorizontal="2dp"
                                android:text="@string/roi_budget_r1_short"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settings_roi_r2"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:paddingHorizontal="2dp"
                                android:text="@string/roi_budget_r2_short"
                                android:textSize="11sp" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>


                        <LinearLayout
                            android:id="@+id/settings_experiment_timer_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/settings_experiment_timer_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/settings_experiment_timer_15"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"

                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/settings_experiment_timer_60"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"

                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/settings_experiment_timer_180"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"

                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/settings_experiment_timer_300"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"

                                    android:textSize="11sp" />

                            </com.google.android.material.button.MaterialButtonToggleGroup>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/alpr_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/alpr_outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_pink"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_folder_24"
                            app:tint="@color/alpr_magenta" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/menu_capture_directory"
                                android:textColor="@color/alpr_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/settings_storage_path"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:maxLines="2"
                                android:text="@string/settings_storage_unset"
                                android:textColor="@color/alpr_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_select_storage"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_choose_directory"
                        app:icon="@drawable/ic_folder_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
