{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/alpr-mobile-research-bundle-v1.schema.json",
  "title": "ALPR mobile research bundle manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "bundle_id",
    "created_at",
    "report_schema",
    "report_id",
    "package_id",
    "variant_id",
    "hash_algorithm",
    "entry_sha256"
  ],
  "properties": {
    "schema": {
      "enum": [
        "alpr.mobile_research_bundle.v1",
        "alpr.mobile_thesis_bundle.v1"
      ]
    },
    "bundle_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "report_schema": { "const": "alpr.mobile_benchmark_report.v1" },
    "report_id": { "type": "string" },
    "package_id": { "type": "string" },
    "variant_id": { "type": "string" },
    "hash_algorithm": { "const": "SHA-256" },
    "self_contained": { "type": "boolean" },
    "exact_source_package_embedded": { "type": "boolean" },
    "crop_count": { "type": "integer", "minimum": 0 },
    "tex_preview_crop_limit": { "type": "integer", "minimum": 0 },
    "entry_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
